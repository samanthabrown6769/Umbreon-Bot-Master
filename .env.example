BOT_TOKEN=your_discord_bot_token_here
ADMIN_IDS=your_discord_user_id

# Optional: enable verified Top.gg voting rewards.
# Set the same random secret in the Top.gg webhook configuration.
TOPGG_WEBHOOK_AUTH=
# Use the public port exposed by your hosting provider; defaults to PORT, then 3000.
TOPGG_WEBHOOK_PORT=
# Optional custom HTTPS vote page; defaults to https://top.gg/bot/<bot-id>/vote.
TOPGG_VOTE_URL=

# Optional: serve Pokemon sprites from Cloudinary instead of Pokemon Showdown.
# Run `npm run upload-sprites` once to mirror the sprites into your account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pokemon-sprites
